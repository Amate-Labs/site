---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <img
    class="site-logo"
    src="/logo.png"
    width="256"
    height="470"
    alt="Amate Labs logo"
  />

  <h1>Amate Labs</h1>

  <p class="mission">
    Amate Labs is an independent research lab currently interested in the
    application of large language and diffusion models to content creation for
    commercial purposes.
  </p>

  <p class="mission">
    Our interests also include the curation of datasets and fine-tunes of
    mainstream models for entertainment and the arts: film, television, and
    media.
  </p>
</BaseLayout>
