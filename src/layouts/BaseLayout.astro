---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import GitHubLogo from "../components/GitHubLogo.astro";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: string;
}

const {
  title,
  description = "Amate Labs is an independent research lab applying large language and diffusion models to content creation.",
  type = "website",
  publishedTime,
} = Astro.props;

const site = Astro.site ?? new URL("https://amatelabs.xyz");
const canonical = new URL(Astro.url.pathname, site);
const pageTitle = title ? `${title} / Amate Labs` : "Amate Labs";
const rssUrl = new URL("/rss.xml", site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Amate Labs" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Amate Labs / Blog"
      href={rssUrl}
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Amate Labs" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/">Amate Labs</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/blog/">Blog</a>
          <a
            class="github-link"
            href="https://github.com/Amate-Labs"
            aria-label="Amate Labs on GitHub"
            rel="me noopener"
            target="_blank"
          >
            <GitHubLogo />
          </a>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <p>© {year} Amate Labs</p>
        <nav aria-label="Contact">
          <a href="mailto:investors@amatelabs.xyz">Investors</a>
          <a href="mailto:collaborate@amatelabs.xyz">Collaborate</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
